# Ambil API ID dan API HASH dari my.telegram.org
API_ID=
API_HASH=

# Prefix command userbot
COMMAND_PREFIX=.

# Folder session relatif dari root project
SESSION_DIR=data/sessions

# Jeda antar pengiriman broadcast (detik). Jangan dibuat terlalu agresif.
BROADCAST_DELAY=2.5

# FloodWait maksimal yang akan ditunggu sebelum chat tersebut dilewati.
FLOOD_WAIT_LIMIT=60
